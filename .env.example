# Local is the zero-credential demo mode. Change to supabase after seeding.
POPSIGN_DATA_BACKEND=local

# hashing runs immediately and is only a deterministic demo baseline.
# embeddinggemma uses google/embeddinggemma-300M through sentence-transformers.
POPSIGN_EMBEDDING_PROVIDER=hashing
POPSIGN_ACCEPT_THRESHOLD=0.35
POPSIGN_MARGIN_THRESHOLD=0.10

# Required only when POPSIGN_DATA_BACKEND=supabase.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Required only when using the optional embeddinggemma provider and the model
# is not already cached locally. Never commit the real value.
GEMMA_TOKEN=
